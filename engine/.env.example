# LLM API (OpenAI-compatible, same convention as MiroFish)
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# 未配置 LLM_API_KEY 时 CLI 自动启用 mock 模式；也可强制：LNE_MOCK=1

# 可选：外部题材风格参考（读取失败则忽略，使用 engine 内置 fallback）
# WEBNOVEL_GENRE_TEMPLATE=../webnovel-writer/webnovel-writer/templates/genres/修仙.md
