# LLM API (OpenAI-compatible, same convention as MiroFish)
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# 未配置 LLM_API_KEY 时 CLI 自动启用 mock 模式；也可强制：LNE_MOCK=1

# 可选：外部题材风格参考（读取失败则忽略，使用 engine 内置 fallback）
# WEBNOVEL_GENRE_TEMPLATE=../webnovel-writer/webnovel-writer/templates/genres/修仙.md

# v0.7.3 视觉资产（Seedream 5.0 Lite）。视觉资产是增强层：
# 未配置 SEEDREAM_API_KEY 时全程稳定降级为古风占位，不阻塞文字主流程。
# SEEDREAM_API_KEY=your_seedream_key
# SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com
# SEEDREAM_MODEL=seedream-5-0-lite
# SEEDREAM_PATH=/api/v3/images/generations   # 接口路径不确定时可覆盖
# LNE_VISUAL_ASSETS=1                          # 设为 0 可关闭视觉资产生成
