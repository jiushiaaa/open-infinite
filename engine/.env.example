# LLM API (OpenAI-compatible, same convention as MiroFish)
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# 未配置 LLM_API_KEY 时 CLI 自动启用 mock 模式；也可强制：LNE_MOCK=1

# 可选：外部题材风格参考（读取失败则忽略，使用 engine 内置 fallback）
# WEBNOVEL_GENRE_TEMPLATE=../webnovel-writer/webnovel-writer/templates/genres/修仙.md

# v0.7.3 视觉资产（Seedream 5.0 Lite）。视觉资产是增强层：
# 未配置 SEEDREAM_API_KEY 时全程稳定降级为古风占位，不阻塞文字主流程。
# SEEDREAM_API_KEY=your_seedream_key
# SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com
# SEEDREAM_MODEL=seedream-5-0-lite
# SEEDREAM_PATH=/api/v3/images/generations   # 接口路径不确定时可覆盖
# LNE_VISUAL_ASSETS=1                          # 设为 0 可关闭视觉资产生成

# 检索增强 provider（显式 smoke / 索引构建 / 检索预览使用；默认 BM25 不会被替换）
# 百炼 text-embedding-v3；未单独设置时复用 DASHSCOPE_API_KEY
# DASHSCOPE_API_KEY=your_dashscope_key
# LNE_EMBEDDING_API_KEY=your_dashscope_key
# LNE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LNE_EMBEDDING_MODEL=text-embedding-v3
# LNE_EMBEDDING_DIMENSION=1024
# LNE_EMBEDDING_BATCH_SIZE=10

# Zilliz Cloud / MilvusClient
# LNE_VECTOR_STORE_PROVIDER=zilliz_cloud
# LNE_ZILLIZ_URI=https://your-cluster.zillizcloud.com:19530
# LNE_ZILLIZ_TOKEN=your_zilliz_api_key_or_user_password
# LNE_ZILLIZ_COLLECTION=unfinale_memory

# 运行时 opt-in：只有开启后，run/resume 才消费百炼 embedding + Zilliz + 百炼 rerank 链路。
# LNE_RETRIEVAL_STRATEGY=hybrid_vector

# 百炼 gte-rerank-v2
# LNE_RERANK_API_KEY=your_dashscope_key
# LNE_RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# LNE_RERANK_MODEL=gte-rerank-v2
# LNE_RERANK_TOP_N=5
